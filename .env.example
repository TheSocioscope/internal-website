# Frontend (GitHub Pages / Next.js)
NEXT_PUBLIC_API_BASE_URL=https://your-api-id.execute-api.eu-west-1.amazonaws.com/prod
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=socioscope.org

# Backend Lambdas (set via CDK/Lambda env, not committed)
AWS_REGION=eu-west-1
ALLOWED_EMAIL_DOMAIN=socioscope.org
DYNAMODB_TABLE_PREFIX=socioscope_
S3_BUCKET=socioscope-internal-{account-id}
FRONTEND_URL=https://your-org.github.io/socioscope-portal
SES_FROM_ADDRESS=noreply@socioscope.org
KMS_KEY_ID=arn:aws:kms:eu-west-1:...
JWT_SECRET=     # generate with: openssl rand -base64 64

# CDK deploy
CDK_DEFAULT_ACCOUNT=your-aws-account-id
CDK_DEFAULT_REGION=eu-west-1
